# Скопируйте этот файл в tool/bot.env и заполните своими значениями.
# Файл bot.env не попадает в git.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Канал: @username или числовой id вида -1001234567890
TELEGRAM_CHANNEL=@my_channel

# Движок перевода: deepl или google.
# Если DeepL отвечает 451 (регион) или 456 (квота), бот сам уйдёт на Google.
TRANSLATE_BACKEND=deepl

# Ключ DeepL. Если не указан, берётся вшитый в сборку.
# DEEPL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# Прокси перед DeepL (например, Cloudflare Worker). Необязательно.
# DEEPL_ENDPOINT=https://deepl.example.workers.dev

# Прямая ссылка на Mini App (BotFather → /newapp → short name).
# Если задана, под последним сообщением поста появится кнопка
# «Открыть приложение». В каналах кнопки web_app не работают, поэтому
# нужна именно ссылка вида https://t.me/<бот>/<short name>.
# MINIAPP_URL=https://t.me/finals_notes_bot/app

# Пауза между проверками сайта в секундах (для --watch).
BOT_INTERVAL=600

# Сколько страниц списка читать. 1 достаточно: новые патчи сверху.
BOT_PAGES=1
